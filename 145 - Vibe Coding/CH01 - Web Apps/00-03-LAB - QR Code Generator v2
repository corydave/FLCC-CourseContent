    //
    // Privacy: everything saved lives in this browser's local storage on this
    // device. Nothing is sent anywhere.

    (function () {
      'use strict';

      // Names for what we save. Each lab has its own id so progress and report
      // drafts never bleed between labs. The theme is shared across handouts.
      const KEY_DONE   = LAB.id + '-done';
      const KEY_REPORT = LAB.id + '-report';
      const KEY_THEME  = 'vibe-theme';

      // Small helpers for saving and loading, wrapped so a browser with storage
      // turned off still gets a working page - it just won't remember.
      function load(key, fallback) {
        try { const v = localStorage.getItem(key); return v === null ? fallback : JSON.parse(v); }
        catch (e) { return fallback; }
      }
      function save(key, value) {
        try { localStorage.setItem(key, JSON.stringify(value)); } catch (e) { /* no storage; carry on */ }
      }

      const $ = (id) => document.getElementById(id);

      // Announce something to screen-reader users without showing it.
      const announcer = $('announce');
      function announce(message) {
        if (!announcer) return;
        announcer.textContent = '';
        setTimeout(function () { announcer.textContent = message; }, 50);
      }

      // Write the lab's name, chapter and time into the page.
      document.title = LAB.title + ' | Vibe Coding';
      if ($('lab-title'))  { $('lab-title').textContent = LAB.title; }
      if ($('lab-ribbon')) { $('lab-ribbon').textContent = LAB.chapter + '  ·  ' + LAB.time; }


      // ---------------------------------------------------------------
      // 1. LIGHT / DARK MODE
      // The <head> already applied the saved choice before paint. This wires
      // up the button and keeps its label honest.
      // ---------------------------------------------------------------
      const themeButton = $('theme-toggle');
      if (themeButton) {
        const themeLabel = $('theme-label');
        const themeGlyph = $('theme-glyph');
        function renderTheme() {
          const dark = document.documentElement.getAttribute('data-theme') === 'dark';
          themeButton.setAttribute('aria-pressed', String(dark));
          themeLabel.textContent = dark ? 'Light mode' : 'Dark mode';   // names what it will switch TO
          themeGlyph.textContent = dark ? '☀' : '☾';
        }
        themeButton.addEventListener('click', function () {
          const dark = document.documentElement.getAttribute('data-theme') === 'dark';
          if (dark) { document.documentElement.removeAttribute('data-theme'); }
          else      { document.documentElement.setAttribute('data-theme', 'dark'); }
          try { localStorage.setItem(KEY_THEME, dark ? 'light' : 'dark'); } catch (e) {}
          renderTheme();
        });
        renderTheme();
      }


      // ---------------------------------------------------------------
      // 2. OPENING AND CLOSING CARDS
      // ---------------------------------------------------------------
      const steps = Array.from(document.querySelectorAll('.step'));
      const TOTAL = steps.length;   // seven, but read from the page rather than assumed

      function openStep(step) {
        step.querySelector('.step-toggle').setAttribute('aria-expanded', 'true');
        step.querySelector('.step-body').hidden = false;
      }
      function closeStep(step) {
        step.querySelector('.step-toggle').setAttribute('aria-expanded', 'false');
        step.querySelector('.step-body').hidden = true;
      }

      steps.forEach(function (step) {
        step.querySelector('.step-toggle').addEventListener('click', function () {
          const isOpen = this.getAttribute('aria-expanded') === 'true';
          if (isOpen) { closeStep(step); } else { openStep(step); }
        });
      });


      // ---------------------------------------------------------------
      // 3. MARK DONE, REMEMBERED
      // ---------------------------------------------------------------
      let done = load(KEY_DONE, []);      // e.g. [1, 2, 3]

      function renderStep(step) {
        const num = Number(step.dataset.step);
        const isDone = done.includes(num);
        const button = step.querySelector('.mark');
        step.classList.toggle('done', isDone);
        button.setAttribute('aria-pressed', String(isDone));
        button.textContent = isDone ? 'Done ✓' : 'Mark done';
      }

      // Marking a step done closes it and opens the next unfinished one, and
      // moves keyboard focus there, so the page carries the student forward.
      steps.forEach(function (step) {
        step.querySelector('.mark').addEventListener('click', function () {
          const num = Number(step.dataset.step);
          if (done.includes(num)) {
            done = done.filter(function (n) { return n !== num; });
            renderStep(step);
          } else {
            done.push(num);
            renderStep(step);
            closeStep(step);
            const next = steps.find(function (s) { return !done.includes(Number(s.dataset.step)); });
            if (next) { openStep(next); next.querySelector('.step-toggle').focus(); }
          }
          save(KEY_DONE, done);
          renderProgress();
        });
      });


      // ---------------------------------------------------------------
      // 4. THE PROGRESS BAR
      // ---------------------------------------------------------------
      const progressEl    = $('progress');
      const progressLabel = $('progress-label');
      const segments      = Array.from(document.querySelectorAll('.progress-bar span'));

      function renderProgress() {
        if (!progressEl) return;
        const count = done.length;
        segments.forEach(function (seg, i) { seg.classList.toggle('filled', i < count); });
        progressEl.setAttribute('aria-valuenow', String(count));
        progressLabel.textContent = count === TOTAL
          ? 'All ' + TOTAL + ' steps done - nice work'
          : count + ' of ' + TOTAL + ' steps done';
      }


      // ---------------------------------------------------------------
      // 5. COPY BUTTONS
      // Each button names the <pre> it copies in data-copy.
      // ---------------------------------------------------------------
      document.querySelectorAll('.copy').forEach(function (button) {
        button.addEventListener('click', function () {
          const pre = $(button.dataset.copy);
          if (!pre) return;
          const text = pre.textContent;
          const originalLabel = button.textContent;

          function copied() {
            button.textContent = 'Copied ✓';
            announce('Copied to clipboard');
            setTimeout(function () { button.textContent = originalLabel; }, 1800);
          }
          // If the clipboard isn't available, select the text so Ctrl+C works.
          function fallback() {
            const range = document.createRange();
            range.selectNodeContents(pre);
            const sel = window.getSelection();
            sel.removeAllRanges(); sel.addRange(range);
            button.textContent = 'Press Ctrl+C';
            announce('Text selected. Press Control C to copy.');
            setTimeout(function () { button.textContent = originalLabel; }, 3000);
          }

          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(copied, fallback);
          } else { fallback(); }
        });
      });


      // ---------------------------------------------------------------
      // 6. SHOW / HIDE ANSWERS
      // ---------------------------------------------------------------
      document.querySelectorAll('.reveal').forEach(function (button) {
        button.addEventListener('click', function () {
          const answer = $(button.getAttribute('aria-controls'));
          const isOpen = button.getAttribute('aria-expanded') === 'true';
          answer.hidden = isOpen;
          button.setAttribute('aria-expanded', String(!isOpen));
          button.textContent = isOpen ? 'Show answer' : 'Hide answer';
        });
      });


      // ---------------------------------------------------------------
      // 7. THE LAB REPORT (only on handouts that have one - the chapter anchor)
      // ---------------------------------------------------------------
      const reportPanel = $('report');
      if (reportPanel) {
        // The questions are read from the page, so the source decides them.
        const questionFields = Array.from(reportPanel.querySelectorAll('textarea'));
        const REPORT_FIELDS = questionFields.map(function (ta) {
          const label = reportPanel.querySelector('label[for="' + ta.id + '"]');
          return { id: ta.id, label: label ? label.textContent.replace(/\s+/g, ' ').trim() : ta.id };
        });
        const nameInput = $('r-name');
        const urlInput  = $('r-url');           // may not exist before the publishing chapter
        const savedNote = $('report-saved');
        const allInputs = [nameInput, urlInput].filter(Boolean).concat(questionFields);

        // Put a saved draft back into the form on load.
        const draft = load(KEY_REPORT, {});
        allInputs.forEach(function (el) { if (draft[el.id]) { el.value = draft[el.id]; } });

        // Save the whole form whenever anything changes, once per pause in typing.
        let saveTimer = null;
        allInputs.forEach(function (el) {
          el.addEventListener('input', function () {
            clearTimeout(saveTimer);
            saveTimer = setTimeout(function () {
              const data = {};
              allInputs.forEach(function (i) { data[i.id] = i.value; });
              save(KEY_REPORT, data);
              if (savedNote) { savedNote.textContent = 'Saved on this device'; setTimeout(function () { savedNote.textContent = ''; }, 2000); }
            }, 400);
          });
        });

        // Make text safe to drop into HTML. The student's answers are their own
        // words; this makes sure a stray < or & can't change the page.
        function escapeHtml(text) {
          return String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        // Build the printable report from the form, then open the print dialog.
        // "Save as PDF" in that dialog is the PDF generator - no library, and
        // links stay clickable in the PDF.
        $('report-print-btn').addEventListener('click', function () {
          const name = nameInput.value.trim() || '(name not entered)';
          const url  = urlInput ? urlInput.value.trim() : '';
          const when = new Date().toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' });

          // Only real web links become links in the PDF; anything else prints as text.
          const urlIsLink = /^https?:\/\/[^\s]+$/i.test(url);
          const urlLine = !urlInput ? ''
            : 'Link to the lab: ' + (!url ? '<em>not on the web yet</em>' : urlIsLink ? '<a href="' + escapeHtml(url) + '">' + escapeHtml(url) + '</a>' : escapeHtml(url)) + '<br>';

          let html = '';
          html += '<h1>Lab report - ' + escapeHtml(LAB.title) + '</h1>';
          html += '<p class="meta">Chapter: ' + escapeHtml(LAB.chapter) + '<br>';
          html += 'Student: <strong>' + escapeHtml(name) + '</strong><br>';
          html += urlLine;
          html += 'Report generated: ' + escapeHtml(when) + '</p>';

          REPORT_FIELDS.forEach(function (f, i) {
            const answer = $(f.id).value.trim();
            html += '<div class="qa">';
            html += '<p class="question">' + (i + 1) + '. ' + escapeHtml(f.label) + '</p>';
            html += '<p class="response">' + (answer ? escapeHtml(answer) : '<em>(no answer)</em>') + '</p>';
            html += '</div>';
          });

          html += '<h2>Steps marked done</h2><ul class="steps">';
          steps.forEach(function (s) {
            const n = Number(s.dataset.step);
            const title = s.querySelector('h2').textContent.trim();
            html += '<li>' + (done.includes(n) ? '✓ ' : '☐ ') + escapeHtml(title) + '</li>';
          });
          html += '</ul>';
          html += '<p class="footer">Vibe Coding - CSC 145 - Finger Lakes Community College. Generated from the lab handout; the handout itself is one HTML file.</p>';

          $('report-print').innerHTML = html;
          document.body.classList.add('print-report');
          window.addEventListener('afterprint', function restore() {
            document.body.classList.remove('print-report');
            window.removeEventListener('afterprint', restore);
          });
          window.print();
        });

        // Clear the report draft: two clicks, no blocking dialog.
        const clearButton = $('report-clear');
        let clearArmed = false;
        clearButton.addEventListener('click', function () {
          if (!clearArmed) {
            clearArmed = true;
            clearButton.textContent = 'Really clear? Click again';
            setTimeout(function () { clearArmed = false; clearButton.textContent = 'Clear answers'; }, 4000);
            return;
          }
          allInputs.forEach(function (el) { el.value = ''; });
          save(KEY_REPORT, {});
          clearArmed = false;
          clearButton.textContent = 'Clear answers';
          announce('Report answers cleared');
        });
      }


      // ---------------------------------------------------------------
      // 8. START OVER (steps only - the report has its own clear button)
      // ---------------------------------------------------------------
      const resetButton = $('reset');
      if (resetButton) {
        resetButton.addEventListener('click', function () {
          done = [];
          save(KEY_DONE, done);
          steps.forEach(function (step, i) { renderStep(step); if (i === 0) { openStep(step); } else { closeStep(step); } });
          renderProgress();
          announce('Progress cleared. Starting from step one.');
          steps[0].querySelector('.step-toggle').focus();
        });
      }


      // ---------------------------------------------------------------
      // FIRST DRAW
      // Draw every step from saved state, then open the first unfinished one
      // so a returning student lands where they left off.
      // ---------------------------------------------------------------
      steps.forEach(renderStep);
      renderProgress();
      const firstOpen = steps.find(function (s) { return !done.includes(Number(s.dataset.step)); }) || steps[0];
      steps.forEach(function (s) { if (s === firstOpen) { openStep(s); } else { closeStep(s); } });
    })();
  </script>
  <!-- The vocabulary: definitions inlined by the build from shared/vocabulary.html. -->
  <script>
    const VOCAB = {"web-page":{"title":"Web page","match":["web page","web pages","webpage"],"html":"  <p>A text file that a browser knows how to read and draw. The file describes what is on the page (words, headings, buttons) and how it should look and behave. Every page you have ever visited is one of these, no matter how fancy.<\/p>"},"browser":{"title":"Browser","match":["browser","browsers"],"html":"  <p>The program that reads web page files and draws them on your screen: Chrome, Safari, Edge, Firefox. It reads the file top to bottom and follows the instructions in it. When you double-click an <code>.html<\/code> file, this is what opens.<\/p>"},"html":{"title":"HTML","match":["HTML"],"html":"  <p>The language that says what is <em>on<\/em> a page. It is mostly your own words, wrapped in tags that say what each thing is: a heading, a paragraph, a button. Stands for HyperText Markup Language, which you will never need to say out loud.<\/p>"},"css":{"title":"CSS","match":["CSS"],"html":"  <p>The language that says what a page <em>looks like<\/em>: colors, sizes, fonts, spacing. It lives inside the <code>&lt;style&gt;<\/code> tag. In this course the AI writes almost all of it; you will learn to find the one line you want to change.<\/p>"},"javascript":{"title":"JavaScript","match":["JavaScript"],"html":"  <p>The language that makes a page <em>do<\/em> things: count down, flip a card, respond to a click. It lives inside the <code>&lt;script&gt;<\/code> tag. Not related to Java, despite the name.<\/p>"},"vibe-coding":{"title":"Vibe coding","match":["vibe coding","vibe code"],"html":"  <p>Building software by describing what you want to an AI in plain language, running what it gives you, and asking for changes until it is right. You steer; the AI types. The loop is: ask, copy, paste over, save, refresh.<\/p>"},"tag":{"title":"Tag","match":["tag","tags"],"html":"  <p>A word in angle brackets that tells the browser what something is: <code>&lt;h1&gt;<\/code> means <em>a big heading<\/em>, <code>&lt;p&gt;<\/code> means <em>a paragraph<\/em>. Most tags come in pairs, like bookends, with your content between them:<\/p>\n  <pre class=\"sample\">&lt;h1&gt;Hello, world&lt;/h1&gt;<\/pre>\n  <p>The tags never show on the page. Only the words between them do.<\/p>"},"bookends":{"title":"Opening and closing tags (bookends)","match":["bookends","bookend","opening tag","closing tag","opening and closing tags"],"html":"  <p>The two halves of a tag pair. The <strong>opening tag<\/strong> says <em>start<\/em>: <code>&lt;p&gt;<\/code>. The <strong>closing tag<\/strong> is the same word with a slash in front and says <em>stop<\/em>: <code>&lt;/p&gt;<\/code>. Whatever sits between the bookends is the content. Forget the closing tag and everything after it gets swept in - a whole page turns into one giant heading.<\/p>"},"content":{"title":"Content","match":["the content"],"html":"  <p>The words between a pair of tags - the part that actually shows on the page. In <code>&lt;h1&gt;Hello, world&lt;/h1&gt;<\/code>, the content is <em>Hello, world<\/em>. Changing content is always safe; you cannot break a page by changing the words between two tags.<\/p>"},"nesting":{"title":"Nesting","match":["nest inside","nested","nesting"],"html":"  <p>Tags inside tags, like boxes inside boxes. A paragraph sits inside the body; a bit of bold sits inside the paragraph. The rule: whatever you open last, you close first.<\/p>\n  <pre class=\"sample\">&lt;p&gt;Some &lt;strong&gt;bold&lt;/strong&gt; words&lt;/p&gt;<\/pre>"},"six-landmarks":{"title":"The six landmarks","match":["six landmarks","the orientation six","landmarks"],"html":"  <p>The six tags every page in this course has, in the same arrangement: <code>&lt;html&gt;<\/code> around everything; <code>&lt;head&gt;<\/code> for settings, holding <code>&lt;title&gt;<\/code> and <code>&lt;style&gt;<\/code>; and <code>&lt;body&gt;<\/code> for everything you see, with <code>&lt;script&gt;<\/code> usually at its end. Learn them as a map. A 300-line file becomes three rooms to look in.<\/p>"},"doctype":{"title":"&lt;!DOCTYPE html&gt;","match":["<!DOCTYPE html>","doctype"],"html":"  <p>The very first line of every page. It tells the browser <em>this is a modern web page<\/em>. It is not really a tag and it never closes. It is always there and you never think about it.<\/p>"},"html-tag":{"title":"&lt;html&gt; … &lt;/html&gt;","match":["<html>"],"html":"  <p>The outermost pair of bookends. Everything on the page sits between <code>&lt;html&gt;<\/code> near the top and <code>&lt;/html&gt;<\/code> on the last line.<\/p>"},"head":{"title":"&lt;head&gt; … &lt;/head&gt;","match":["<head>","the head"],"html":"  <p>The settings section of a page. Nothing inside the head shows on the page itself. It holds the <code>&lt;title&gt;<\/code> (the browser tab's text) and the <code>&lt;style&gt;<\/code> (how things look). <strong>Head or body?<\/strong> If a visitor can see it, it is in the body; if it is a setting, it is in the head.<\/p>"},"body":{"title":"&lt;body&gt; … &lt;/body&gt;","match":["<body>","the body"],"html":"  <p>Everything a visitor can see: headings, paragraphs, buttons, images, links. The <code>&lt;script&gt;<\/code> usually sits at the very end of the body.<\/p>"},"title":{"title":"&lt;title&gt; … &lt;/title&gt;","match":["<title>"],"html":"  <p>The page's name. It lives in the head and shows on the <strong>browser tab<\/strong>, not on the page. It is the easiest hand edit there is: change the words between the tags, save, refresh, look at the tab.<\/p>\n  <pre class=\"sample\">&lt;title&gt;Dave's Focus Timer&lt;/title&gt;<\/pre>"},"style":{"title":"&lt;style&gt; … &lt;/style&gt;","match":["<style>"],"html":"  <p>Where the looks live: colors, fonts, sizes, spacing. It sits in the head and is written in CSS. Usually the longest part of a file, and the part you will change least by hand.<\/p>"},"script":{"title":"&lt;script&gt; … &lt;/script&gt;","match":["<script>","the script"],"html":"  <p>Where the behavior lives: the JavaScript that makes a page count down, flip a card, or make a QR code. Usually at the end of the body. When something <em>moves<\/em> or <em>responds<\/em>, this is where it happens.<\/p>"},"h1":{"title":"&lt;h1&gt; … &lt;/h1&gt;","match":["<h1>"],"html":"  <p>The biggest heading on a page. <code>&lt;h2&gt;<\/code> through <code>&lt;h6&gt;<\/code> are smaller headings, in order. Changing the words between the tags is the safest edit you can make.<\/p>"},"p":{"title":"&lt;p&gt; … &lt;/p&gt;","match":["<p>"],"html":"  <p>A paragraph. Every paragraph gets its own pair. The browser adds a little space above and below each one, so two paragraphs look like two paragraphs. Without the tags, the words run together into one lump.<\/p>"},"br":{"title":"&lt;br /&gt;","match":["<br />","<br>","line break","line breaks"],"html":"  <p>A line break: <em>end the line here<\/em>, inside a paragraph. For the lines of an address, a poem, an ingredient list. It has no closing tag, because nothing goes inside a line break; instead the slash goes at the end. Two in a row make a blank line. But for a new <em>thought<\/em>, use <code>&lt;p&gt;<\/code>, not a pile of <code>&lt;br /&gt;<\/code>s.<\/p>\n  <pre class=\"sample\">3325 Marvin Sands Drive&lt;br /&gt;\nCanandaigua, NY 14424<\/pre>"},"self-closing":{"title":"Self-closing tag","match":["self-closing","self-closing tag"],"html":"  <p>A tag that is complete on its own, with no closing partner, because nothing goes inside it. The slash goes at the end: <code>&lt;br /&gt;<\/code>. You will meet <code>&lt;img … /&gt;<\/code> next chapter - an image has nothing inside it either.<\/p>"},"strong-em":{"title":"&lt;strong&gt; and &lt;em&gt;","match":["<strong>","<em>"],"html":"  <p>Bold and emphasis (usually italic), wrapped around a few words inside a paragraph: <code>&lt;p&gt;This is &lt;strong&gt;important&lt;/strong&gt;.&lt;/p&gt;<\/code><\/p>"},"button":{"title":"&lt;button&gt; … &lt;/button&gt;","match":["<button>"],"html":"  <p>A thing to press. The words between the tags are its label. What the button <em>says<\/em> is HTML; what it <em>does<\/em> is JavaScript, somewhere in the script.<\/p>"},"whitespace":{"title":"Whitespace","match":["whitespace","white space","indentation","indented"],"html":"  <p>Spaces, tabs, and new lines. The browser squashes any amount of it down to one space, so pressing Enter in the code does nothing and ten spaces look like one. All that neat indentation in the AI's code is for <em>you<\/em>, so you can see what is inside what. The browser ignores it.<\/p>"},"comment":{"title":"Comment","match":["comment","comments","commented out"],"html":"  <p>A note in the code that the browser skips completely. For people, not machines. In HTML: <code>&lt;!-- like this --&gt;<\/code>. In JavaScript: a line starting with <code>//<\/code>. The AI writes lots of them, one above nearly every block, saying what the block does in plain language. They are the first place to look when you want to change something.<\/p>"},"file-extension":{"title":"File extension","match":["file extension","file extensions","extensions shown","show file extensions"],"html":"  <p>The last part of a file's name, after the dot: <code>.html<\/code>, <code>.jpg<\/code>, <code>.txt<\/code>. It tells the computer what kind of file it is. Mac and Windows <em>hide<\/em> extensions by default, so a file that looks like <code>qr-code.html<\/code> can secretly be <code>qr-code.html.txt<\/code> and show a blank page. Turning extensions on is the first thing this course asks you to do.<\/p>"},"plain-text":{"title":"Plain text","match":["plain text","plain-text"],"html":"  <p>Text with nothing hidden in it: no fonts, no bold, no invisible formatting. Code has to be plain text. Word, Google Docs, TextEdit, and Notepad all add or mangle things, which is why you need a plain-text editor like TXTEDTR.<\/p>"},"txtedtr":{"title":"TXTEDTR","match":["TXTEDTR","text editor","plain-text editor"],"html":"  <p>The plain-text editor we use in this course, at <a href=\"https://txtedtr.app\" target=\"_blank\" rel=\"noopener\">txtedtr.app<\/a>. It is one HTML file, built with AI, by your instructor - the same kind of thing you are making. Notepad++, VS Code, or Sublime Text work too. What does not work: Word, Google Docs, TextEdit, Notepad.<\/p>"},"save-as":{"title":"Save As","match":["Save As","Save as"],"html":"  <p>Saving a file under a name and location you choose. In this course you type the whole name yourself, including the <code>.html<\/code>, and pick the <code>vibe-coding<\/code> folder on purpose. Plain <em>Save<\/em> writes over the file you already have; <em>Save As<\/em> makes a new one.<\/p>"},"save-refresh":{"title":"Save, then refresh","match":["save and refresh","save then refresh","refresh the browser"],"html":"  <p>The two-step loop for seeing a change. <strong>Save<\/strong> the file in your editor, then <strong>refresh<\/strong> the browser tab (the circular arrow, or <kbd>F5<\/kbd>, or <kbd>⌘<\/kbd>+<kbd>R<\/kbd>) so it reads the file again. If nothing changed, you skipped one of the two. This is the first thing to check, every time.<\/p>"},"copy-button":{"title":"The Copy button","match":["Copy button"],"html":"  <p>The small button in the corner of a code block in the AI's reply. It copies the whole block, exactly. Always use it instead of selecting the code by hand, which misses the top or bottom line more often than you would think.<\/p>"},"paste-over":{"title":"Paste over everything","match":["paste over everything","paste it over everything","paste over"],"html":"  <p>Replacing the whole file with the AI's new version: in your editor, select all (<kbd>Ctrl<\/kbd>+<kbd>A<\/kbd>, Mac <kbd>⌘<\/kbd>+<kbd>A<\/kbd>), then paste. Not <em>adding<\/em> the new code below the old - replacing it. Half-pasted files are a common cause of a blank page.<\/p>"},"version-copy":{"title":"Version copy","match":["version copy","versions","the version"],"html":"  <p>A duplicate of a working file, made <em>before<\/em> you let the AI change it: <code>pomodoro.html<\/code> becomes <code>pomodoro-v1.html<\/code>. The plain name is always the current version; the numbered copies are the history. If an iteration breaks things, the copy is your way back.<\/p>"},"developer-console":{"title":"Developer Console","match":["Developer Console","the console","DevTools"],"html":"  <p>A panel built into every browser that shows what went wrong and where. Open it with <kbd>F12<\/kbd>, or right-click the page and choose <em>Inspect<\/em>, then the <em>Console<\/em> tab. A <strong>red line<\/strong> is an error: it has a message and a line number. Copy the red line exactly and paste it to the AI. Most students do not know this panel exists; now you do.<\/p>"},"library":{"title":"Library","match":["library","libraries"],"html":"  <p>Someone else's code that your page borrows, usually with one line like <code>&lt;script src=\"https://…\"&gt;<\/code>. The QR code generator borrows a library that knows how to draw QR codes; nobody writes that part themselves. It is also why some pages need the internet even though they are files on your computer.<\/p>"},"screenshot":{"title":"Screenshot","match":["screenshot","screenshots"],"html":"  <p>A picture of your screen. Mac: <kbd>Shift<\/kbd>+<kbd>⌘<\/kbd>+<kbd>4<\/kbd>, then drag a box. Windows: <kbd>Win<\/kbd>+<kbd>Shift<\/kbd>+<kbd>S<\/kbd>. Chromebook: <kbd>Shift<\/kbd>+<kbd>Ctrl<\/kbd>+<kbd>Show windows<\/kbd>. You will use it for hand-ins and for showing someone exactly what went wrong.<\/p>"},"prompt":{"title":"Prompt","match":["prompt","prompts"],"html":"  <p>What you type to the AI: a description of what you want, in your own words, like you are explaining it to a friend. Say what goes in, what comes out, and what it should look like. Then paste the specification after it.<\/p>"},"specification":{"title":"Specification (the spec)","match":["specification","the spec","spec block"],"html":"  <p>The block of rules you paste at the end of every prompt. It tells the AI how to build things for this course: one file, plain comments, works on a phone, and so on. You are not expected to understand every line yet; one line gets explained per chapter.<\/p>"},"iteration":{"title":"Iteration","match":["iteration","iterations","iterate"],"html":"  <p>Asking for a change to something that already works, then another, then another. <em>Add a color picker. Now put my initials in the middle.<\/em> Small asks, one at a time, is the normal way to build; nobody gets the whole thing in one prompt.<\/p>"},"keep-everything":{"title":"“Keep everything else the same”","match":["keep everything else the same","keep everything else exactly the same"],"html":"  <p>The sentence to put at the end of an ask for one change. Left alone, an AI asked to change one thing will sometimes redesign three, or quietly drop a feature you added earlier. Saying what <em>not<\/em> to touch is part of asking well.<\/p>"},"hand-edit":{"title":"Hand edit","match":["hand edit","hand edits"],"html":"  <p>A change you make to the code yourself, in the editor, without asking the AI. This course builds up to them slowly: first the words between two tags (safe; you cannot break anything), then a number the code uses, then a date with a strict format.<\/p>"},"definition-of-done":{"title":"Definition of Done","match":["Definition of Done"],"html":"  <p>The one sentence on every lab that says what finished looks like. If your app does that, the lab is done. Everything else in the lab is a bonus.<\/p>"},"setinterval":{"title":"setInterval","match":["setInterval"],"html":"  <p>The line of JavaScript that makes a page tick: <em>run this again every so many milliseconds<\/em>. <code>setInterval(update, 1000)<\/code> means run <code>update<\/code> once a second. It is the reason a countdown counts and a timer times. You will recognize it in every app that moves.<\/p>"},"milliseconds":{"title":"Milliseconds","match":["milliseconds","millisecond"],"html":"  <p>Thousandths of a second. JavaScript measures time in them, so <code>1000<\/code> means one second and <code>60000<\/code> means one minute. When you see a suspiciously large number next to a timer, it is probably milliseconds.<\/p>"},"nan":{"title":"NaN","match":["NaN"],"html":"  <p>“Not a Number.” What the browser says when it was asked to do math on something that is not a number - most often a date typed in a form it did not understand. If you just edited a date and see this, look at what you changed: a month over 12, a missing dash, a lost quote. Fix that one thing.<\/p>"},"value":{"title":"Value","match":["a value"],"html":"  <p>A fact the code uses: the <code>25<\/code> in a Pomodoro timer, the date in a countdown. Values often sit near the top of the script so you can find them. Changing a value changes how the whole app behaves, which is why it is a step up from changing words.<\/p>"}};
  </script>
  <script>
    /* ====================================================================
       Vibe Coding - vocabulary pop-ups
       Inlined by the build into every lab and reading, after lab.js.

       The build also inlines a VOCAB object (from shared/vocabulary.html):

         VOCAB = {
           "tag": { title: "Tag", match: ["tag", "tags"], html: "<p>...</p>" },
           ...
         }

       What this script does:
         1. Walks the text of the page and, the FIRST time a vocabulary term
            appears in each step (or each section, on a reading), wraps that
            word in a small button. Later mentions in the same step are left
            alone, so a page is not covered in links.
         2. Clicking the button opens a small pop-up (a native <dialog>) with
            the term's definition and a link to the full vocabulary page.

       It never touches code samples in <pre>, the demo <textarea>s, links,
       other buttons, headings, or the pretend-browser chrome. Inline <code>
       IS allowed, on purpose: that is where "<title>" appears in a sentence.
       ==================================================================== */
    (function () {
      'use strict';
      if (typeof VOCAB !== 'object' || !VOCAB) return;
      const dialog = document.getElementById('vocab-dialog');
      if (!dialog) return;

      // ---------------------------------------------------------------
      // 1. ONE REGULAR EXPRESSION FOR EVERY SPELLING OF EVERY TERM
      // Longest spellings first, so "opening tag" wins over "tag".
      // ---------------------------------------------------------------
      const spellings = [];             // [{ text, id }]
      Object.keys(VOCAB).forEach(function (id) {
        (VOCAB[id].match || []).forEach(function (text) {
          if (text.trim()) spellings.push({ text: text.trim(), id: id });
        });
      });
      spellings.sort(function (a, b) { return b.text.length - a.text.length; });
      const byLower = {};
      spellings.forEach(function (s) { byLower[s.text.toLowerCase()] = s.id; });

      function escapeRegex(text) { return text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }
      const pattern = new RegExp(spellings.map(function (s) { return escapeRegex(s.text); }).join('|'), 'gi');

      // A match only counts if it is a whole word: no letter or digit directly
      // before it (when it starts with one) or after it (when it ends with one).
      // "tag" must not light up inside "tags" or "stage".
      // Dots, hyphens, slashes and underscores count as glue too, so "html" does
      // not light up inside the file name "qr-code.html".
      const GLUE = /[\w.\-\/_]/;
      function isWholeWord(text, start, end) {
        const first = text[start], last = text[end - 1];
        const before = text[start - 1] || ' ', after = text[end] || ' ';
        if (/\w/.test(first) && GLUE.test(before)) return false;
        if (/\w/.test(last) && GLUE.test(after)) return false;
        return true;
      }

      // ---------------------------------------------------------------
      // 2. WHERE NOT TO LOOK
      // ---------------------------------------------------------------
      const SKIP = 'pre, textarea, svg, a, button, label, input, select, script, style, h1, h2, dialog, .fake-chrome, .contents, .ribbon, .term-link, .tools-note, .submit-card';

      function skippable(node) {
        for (let el = node.parentElement; el; el = el.parentElement) {
          if (el.matches(SKIP)) return true;
        }
        return false;
      }

      // ---------------------------------------------------------------
      // 3. LINK THE FIRST MENTION OF EACH TERM IN EACH BLOCK
      // A "block" is a step body on a lab, or a section on a reading.
      // ---------------------------------------------------------------
      const main = document.getElementById('main');
      if (!main) return;
      let blocks = Array.from(main.querySelectorAll('.step-body, :scope > section'));
      if (!blocks.length) blocks = [main];

      blocks.forEach(function (block) {
        const seen = new Set();
        const walker = document.createTreeWalker(block, NodeFilter.SHOW_TEXT);
        const textNodes = [];
        let node;
        while ((node = walker.nextNode())) {
          if (node.nodeValue.trim() && !skippable(node)) textNodes.push(node);
        }
        textNodes.forEach(function (textNode) { linkTerms(textNode, seen); });
      });

      function linkTerms(textNode, seen) {
        const text = textNode.nodeValue;
        pattern.lastIndex = 0;
        let match, last = 0;
        const pieces = [];
        while ((match = pattern.exec(text))) {
          const start = match.index, end = start + match[0].length;
          const id = byLower[match[0].toLowerCase()];
          if (!id || seen.has(id) || !isWholeWord(text, start, end)) continue;
          seen.add(id);
          pieces.push(document.createTextNode(text.slice(last, start)));
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'term-link';
          button.dataset.term = id;
          button.textContent = match[0];
          button.setAttribute('aria-label', match[0] + ' - show definition');
          pieces.push(button);
          last = end;
        }
        if (!pieces.length) return;
        pieces.push(document.createTextNode(text.slice(last)));
        const parent = textNode.parentNode;
        pieces.forEach(function (piece) { parent.insertBefore(piece, textNode); });
        parent.removeChild(textNode);
      }

      // ---------------------------------------------------------------
      // 4. THE POP-UP
      // A native <dialog>: Escape closes it, focus stays inside it, and the
      // page behind is dimmed. When it closes, focus goes back to the word
      // that opened it.
      // ---------------------------------------------------------------
      const titleEl = dialog.querySelector('#vocab-title');
      const bodyEl  = dialog.querySelector('#vocab-body');
      const moreEl  = dialog.querySelector('#vocab-more');
      let opener = null;

      function open(id, button) {
        const entry = VOCAB[id];
        if (!entry) return;
        opener = button;
        titleEl.innerHTML = entry.title;
        // The definition HTML comes from shared/vocabulary.html, written by the
        // course author and inlined at build time - not from anything a visitor
        // typed - so putting it in with innerHTML is safe here.
        bodyEl.innerHTML = entry.html;
        if (moreEl) moreEl.hash = '#' + id;
        if (typeof dialog.showModal === 'function') { dialog.showModal(); } else { dialog.setAttribute('open', ''); }
      }

      document.addEventListener('click', function (e) {
        const button = e.target.closest('.term-link');
        if (button) { e.preventDefault(); open(button.dataset.term, button); }
      });

      dialog.querySelector('#vocab-close').addEventListener('click', function () { dialog.close(); });
      // Clicking the dimmed backdrop (outside the pop-up's box) closes it too.
      dialog.addEventListener('click', function (e) {
        const box = dialog.getBoundingClientRect();
        const outside = e.clientX < box.left || e.clientX > box.right || e.clientY < box.top || e.clientY > box.bottom;
        if (outside) dialog.close();
      });
      dialog.addEventListener('close', function () { if (opener) { opener.focus(); opener = null; } });
    })();
  </script>
</body>
</html>
