  chapters/01-files/02-qr-code-v2.html. Edit the source, or shared/lab.css and shared/lab.js,
  and rebuild. Anything changed here is overwritten on the next build.

  This handout is one HTML file: the page, its styles, and its behavior all
  live here. It follows the same spec block students use for their own apps,
  on purpose - View Source and it should look like something you could have
  made. The only thing it loads from outside is the two fonts.

  Privacy: what is saved in this browser's local storage, on this device only -
  which steps are marked done, the light/dark choice, and (on labs with a
  report) a draft of the report so a refresh doesn't lose it. Nothing is sent
  anywhere.
-->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Vibe Coding</title>

  <!-- What names this lab. Written by the build from the source's header. -->
  <script>
    const LAB = {
      title:   "QR code generator v2 - make it yours, by asking",
      chapter: "Out of the chat, onto your computer",
      time:    "About 30 minutes",
      id:      "vibe-lab-qr-v2"
    };
  </script>

  <!-- Apply the saved light/dark choice BEFORE the page paints, so a student
       who chose dark doesn't see a white flash on every load. Default is light. -->
  <script>
    (function () {
      try {
        if (localStorage.getItem('vibe-theme') === 'dark') { document.documentElement.setAttribute('data-theme', 'dark'); }
      } catch (e) { /* storage unavailable - stay light */ }
    })();
  </script>

  <!-- The one external request in this file: the two course typefaces. -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Comfortaa:wght@500;700&display=swap">

  <style>
    /*
      Vibe Coding - lab handout stylesheet (SOURCE)
      This file is inlined into every published handout by build/build.py.
      Edit it here, run the build, and every lab picks up the change.
      Never edit the <style> block inside a file in publish/ - it is overwritten.

      Tokens and contrast reasoning: design document section 6.
    */

    /* ------------------------------------------------------------------
       DESIGN TOKENS - LIGHT (the default)
       Every color on the page goes through one of these names. Contrast
       ratios are measured against white, the card color in light mode.
       ------------------------------------------------------------------ */
    :root {
      color-scheme: light;

      --ink:         #1a1523;   /* body text             17.87:1 */
      --ink-soft:    #5b5468;   /* secondary text         7.21:1 */
      --ink-faint:   #6f6880;   /* metadata, counts       5.29:1 */
      --paper:       #ffffff;   /* page background */
      --card:        #ffffff;   /* raised surfaces (they get a border instead of a tint) */
      --line:        #e2dcec;   /* borders and rules */
      --accent:      #9900ff;   /* brand purple: headings, buttons, numbers, focus rings (5.53:1 - passes for text on white) */
      --accent-text: #7a00cc;   /* deeper purple for links and small labels (7.78:1) */
      --accent-soft: #f3ebff;   /* tinted backgrounds */
      --heading:     #9900ff;   /* headings use the brand purple in light mode */
      --flag:        #a04a00;   /* troubleshooting cards (6.04:1) */
      --danger:      #b3261e;   /* destructive actions (6.54:1) */
      --on-accent:   #ffffff;   /* text on a purple fill (5.53:1 on #9900ff) */

      --font-body:    "Atkinson Hyperlegible", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      --font-display: "Comfortaa", ui-rounded, "SF Pro Rounded", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      --font-mono:    ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;

      --radius: 14px;
      --gap: 1rem;
      --measure: 44rem;   /* comfortable reading width */
    }

    /* ------------------------------------------------------------------
       DESIGN TOKENS - DARK
       The original course palette. Ratios are against --card (#1c1826).
       Only the colors change; nothing about layout does.
       ------------------------------------------------------------------ */
    [data-theme="dark"] {
      color-scheme: dark;

      --ink:         #e8e6ed;   /* 14.05:1 */
      --ink-soft:    #a09aad;   /*  6.39:1 */
      --ink-faint:   #8a8397;   /*  4.53:1 */
      --paper:       #12101a;
      --card:        #1c1826;
      --line:        #2f2a3d;
      --accent:      #9900ff;   /* 3.41:1 - fine for components, NOT for small text on dark */
      --accent-text: #b478ff;   /* 6.34:1 - the readable purple */
      --accent-soft: #241338;
      --heading:     #b478ff;   /* headings step up to the readable purple in dark mode */
      --flag:        #ffa94d;   /* 9.13:1 */
      --danger:      #ff8080;   /* 7.16:1 */
      --on-accent:   #ffffff;
    }

    /* ------------------------------------------------------------------
       BASE
       ------------------------------------------------------------------ */
    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font-family: var(--font-body);
      font-size: 1.0625rem;      /* 17px */
      line-height: 1.6;
      -webkit-text-size-adjust: 100%;
    }

    /* Comfortaa runs optically small and wide: a little extra size, no
       negative letter-spacing. Headings are purple, per the course look. */
    h1, h2, h3 {
      font-family: var(--font-display);
      font-weight: 700;
      letter-spacing: 0;
      line-height: 1.25;
      margin: 0;
      color: var(--heading);
    }

    p { margin: 0 0 1rem; }
    p:last-child { margin-bottom: 0; }

    a { color: var(--accent-text); }

    code, kbd, pre { font-family: var(--font-mono); font-size: 0.95em; }

    /* Inline code - filenames, tags, literal terms */
    code {
      background: var(--accent-soft);
      color: var(--ink);
      padding: 0.1em 0.4em;
      border-radius: 6px;
    }

    /* Keyboard keys */
    kbd {
      background: var(--card);
      border: 1px solid var(--line);
      border-bottom-width: 2px;
      border-radius: 6px;
      padding: 0.05em 0.45em;
    }

    /* One visible focus ring for everything focusable. */
    :focus-visible {
      outline: 3px solid var(--accent);
      outline-offset: 3px;
      border-radius: 6px;
    }

    @media (prefers-reduced-motion: reduce) {
      * { transition: none !important; animation: none !important; }
    }

    /* Skip link - invisible until a keyboard user tabs to it. */
    .skip {
      position: absolute; left: 1rem; top: -4rem;
      background: var(--accent); color: var(--on-accent);
      padding: 0.6rem 1rem; border-radius: 8px;
      font-weight: 700; text-decoration: none; z-index: 10;
    }
    .skip:focus { top: 1rem; }

    /* ------------------------------------------------------------------
       LAYOUT
       ------------------------------------------------------------------ */
    .wrap {
      width: min(100% - 2rem, var(--measure));
      margin: 0 auto;
      padding: 1.5rem 0 4rem;
    }

    /* The ribbon row: chapter + time on the left, theme toggle on the right. */
    .ribbon {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 0.75rem;
    }

    .eyebrow {
      color: var(--accent-text);
      font-weight: 700;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin: 0;
    }

    h1 { font-size: clamp(1.8rem, 2.4vw + 1.2rem, 2.6rem); margin-bottom: 0.6rem; }

    .lede { color: var(--ink-soft); font-size: 1.1rem; }

    /* The "your tools may differ" note under the title. */
    .tools-note {
      color: var(--ink-faint);
      font-size: 0.95rem;
      border-left: 3px solid var(--line);
      padding-left: 0.9rem;
      margin: 1rem 0 0;
    }

    /* ------------------------------------------------------------------
       PROGRESS - seven segments, one per beat
       ------------------------------------------------------------------ */
    .progress { display: grid; gap: 0.5rem; margin: 1.5rem 0 2rem; }

    .progress-bar {
      display: grid; grid-template-columns: repeat(7, 1fr);
      gap: 4px; height: 10px;
    }

    .progress-bar span { background: var(--line); border-radius: 5px; transition: background 200ms ease; }
    .progress-bar span.filled { background: var(--accent); }

    .progress-text {
      color: var(--ink-faint); font-size: 0.95rem;
      display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;
    }

    /* ------------------------------------------------------------------
       STEP CARDS
       ------------------------------------------------------------------ */
    .step {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      margin-bottom: var(--gap);
      overflow: hidden;
    }

    .step.done { border-color: var(--accent); }

    .step-head { display: flex; align-items: center; gap: 0.75rem; padding: 0.9rem 1rem; }

    .step-num {
      flex: none; width: 2.1rem; height: 2.1rem;
      display: grid; place-items: center; border-radius: 50%;
      background: var(--accent-soft); color: var(--accent-text);
      font-family: var(--font-display); font-weight: 700;
    }

    .step.done .step-num { background: var(--accent); color: var(--on-accent); }

    /* The title is a button so the whole heading is clickable and
       keyboard-reachable, styled to look like a heading. */
    .step-toggle {
      flex: 1; display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
      background: none; border: 0; padding: 0.25rem 0;
      color: var(--ink); font: inherit; text-align: left; cursor: pointer;
    }

    .step-toggle h2 { font-size: 1.2rem; }

    /* Chevron that rotates when the card is open. */
    .chev {
      flex: none; width: 0.7rem; height: 0.7rem;
      border-right: 2px solid var(--ink-soft); border-bottom: 2px solid var(--ink-soft);
      transform: rotate(45deg); transition: transform 200ms ease; margin-right: 0.3rem;
    }
    .step-toggle[aria-expanded="true"] .chev { transform: rotate(-135deg); }

    .step-body {
      padding: 1.1rem 1rem 1.25rem calc(1rem + 2.1rem + 0.75rem);
      border-top: 1px solid var(--line);
    }
    .step-body[hidden] { display: none; }

    .step-body h3 {
      font-size: 1.05rem;
      margin: 1.4rem 0 0.6rem;
    }

    /* ------------------------------------------------------------------
       BUTTONS
       ------------------------------------------------------------------ */
    .btn {
      font: inherit; font-weight: 700; font-size: 0.95rem;
      padding: 0.5rem 0.9rem; border-radius: 999px;
      border: 2px solid var(--accent); background: transparent; color: var(--accent-text);
      cursor: pointer; white-space: nowrap;
      transition: background 150ms ease, color 150ms ease;
    }
    .btn:hover { background: var(--accent-soft); }

    .btn[aria-pressed="true"] { background: var(--accent); color: var(--on-accent); }

    .btn.solid { background: var(--accent); color: var(--on-accent); }
    .btn.solid:hover { filter: brightness(1.08); }

    .btn.quiet { border-color: var(--line); color: var(--ink-soft); font-weight: 400; }
    .btn.quiet:hover { color: var(--ink); background: var(--accent-soft); }

    .btn.danger { border-color: var(--line); color: var(--danger); }

    /* The theme toggle is a quiet button with a little sun/moon glyph. */
    .theme { display: inline-flex; align-items: center; gap: 0.4rem; }

    /* ------------------------------------------------------------------
       PROMPT / SPEC BOXES
       ------------------------------------------------------------------ */
    .prompt { position: relative; margin: 1rem 0; }

    .prompt pre {
      margin: 0; padding: 3rem 1rem 1rem;      /* top room for the copy button */
      background: var(--accent-soft);
      border: 1px solid var(--line); border-left: 4px solid var(--accent);
      border-radius: 10px;
      white-space: pre-wrap; overflow-wrap: anywhere;
      line-height: 1.5; font-size: 0.95rem; color: var(--ink);
    }

    .prompt .copy { position: absolute; top: 0.6rem; right: 0.6rem; }

    /* ------------------------------------------------------------------
       CALLOUTS
       .flag  - orange: a specific trap and how to get out of it
       .note  - purple: the universal reminder (save, refresh)
       .aside - a quiet side comment
       ------------------------------------------------------------------ */

    /* Troubleshooting cards are accordions: a <details> element, closed by
       default, so a student scans the titles for their symptom and opens
       only the one that matches. Native <details> is keyboard-accessible
       with no script. Each card opens independently - two problems at once
       is normal. */
    .flag {
      border: 1px solid var(--flag); border-left-width: 4px; border-radius: 10px;
      margin: 0.6rem 0;
      background: color-mix(in srgb, var(--flag) 7%, var(--card));
    }

    .flag summary, .note summary {
      cursor: pointer; list-style: none;
      position: relative;                 /* anchors the chevron */
      padding: 0.7rem 2.6rem 0.7rem 1rem; /* right padding leaves room for it */
      font-weight: 700; color: var(--flag);
    }
    .flag summary::-webkit-details-marker, .note summary::-webkit-details-marker { display: none; }

    /* The same chevron the step cards use, so open/closed reads the same way.
       Positioned absolutely so a <code> chunk inside the title flows inline
       with the words instead of being pushed to the far side. */
    .flag summary::after, .note summary::after {
      content: ""; position: absolute; right: 1.1rem; top: 50%;
      width: 0.55rem; height: 0.55rem; margin-top: -0.45rem;
      border-right: 2px solid var(--flag); border-bottom: 2px solid var(--flag);
      transform: rotate(45deg); transition: transform 200ms ease;
    }
    .flag[open] summary::after, .note[open] summary::after { transform: rotate(-135deg); margin-top: -0.15rem; }

    /* The two "start here" cards are the same accordion as the orange
       troubleshooting cards, in purple, because they apply to every lab
       rather than to one symptom. These rules come after the .flag rules
       above on purpose, so the purple wins. */
    .note {
      border: 1px solid var(--accent); border-left-width: 4px; border-radius: 10px;
      margin: 0.6rem 0;
      background: var(--accent-soft);
    }
    .note summary { color: var(--accent-text); }
    .note summary::after { border-color: var(--accent-text); }
    .note .note-body { padding: 0 1rem 0.9rem; }
    .note .note-body p:last-child { margin-bottom: 0; }

    .flag .flag-body { padding: 0 1rem 0.9rem; }
    .flag .flag-body p:last-child { margin-bottom: 0; }

    /* The folder tree: a text diagram of where files should be right now.
       Shown in a figure with a caption saying the names may differ but the
       shape must match. */
    .tree { margin: 1rem 0; }
    .tree pre {
      margin: 0; padding: 0.9rem 1rem;
      background: var(--accent-soft); border: 1px solid var(--line); border-radius: 10px;
      font-size: 0.95rem; line-height: 1.5; color: var(--ink);
      overflow-x: auto;                    /* a wide tree scrolls inside its box, never the page */
    }
    .tree .here { color: var(--accent-text); font-weight: 700; }
    .tree figcaption { color: var(--ink-soft); font-size: 0.95rem; margin-top: 0.5rem; }

    /* The per-browser shortcut table inside the Developer Console callout. */
    .shortcuts { width: 100%; border-collapse: collapse; margin: 0.6rem 0 0.4rem; font-size: 0.95rem; }
    .shortcuts th, .shortcuts td { text-align: left; padding: 0.35rem 0.5rem 0.35rem 0; vertical-align: top; }
    .shortcuts th { font-weight: 700; color: var(--ink-soft); }
    .shortcuts tr + tr td, .shortcuts tr + tr th { border-top: 1px solid var(--line); }

    /* The two group labels above the accordions - "This lab", "Every lab". */
    .group {
      font-family: var(--font-body); font-size: 0.85rem; font-weight: 700;
      letter-spacing: 0.06em; text-transform: uppercase;
      color: var(--ink-faint); margin: 1.2rem 0 0.4rem;
    }

    .aside {
      border-left: 4px solid var(--accent); padding: 0.2rem 0 0.2rem 1rem;
      color: var(--ink-soft); margin: 1rem 0;
    }

    /* Read-it questions with reveals */
    .q { border-top: 1px solid var(--line); padding: 0.9rem 0; }
    .q:first-of-type { border-top: 0; padding-top: 0; }
    .q p { margin-bottom: 0.5rem; }

    .answer { margin-top: 0.6rem; padding: 0.7rem 0.9rem; background: var(--accent-soft); border-radius: 8px; }
    .answer[hidden] { display: none; }

    .step-body ol, .step-body ul { padding-left: 1.3rem; margin: 0 0 1rem; }
    .step-body li { margin-bottom: 0.4rem; }

    /* ------------------------------------------------------------------
       DEFINITION OF DONE + LAB REPORT
       ------------------------------------------------------------------ */
    .panel {
      background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
      padding: 1.25rem 1.5rem; margin-top: 2rem;
    }

    .panel h2 { font-size: 1.3rem; margin-bottom: 0.5rem; }

    .panel .intro { color: var(--ink-soft); }

    .field { display: grid; gap: 0.35rem; margin: 1.1rem 0; }

    .field label { font-weight: 700; }

    .field .help { color: var(--ink-faint); font-size: 0.92rem; font-weight: 400; }

    .field input, .field textarea {
      font: inherit; color: var(--ink); background: var(--paper);
      border: 1px solid var(--line); border-radius: 8px; padding: 0.6rem 0.75rem;
      width: 100%;
    }

    .field textarea { min-height: 5.5rem; resize: vertical; line-height: 1.5; }

    .field input:focus, .field textarea:focus { border-color: var(--accent); }

    .actions { display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center; margin-top: 1.25rem; }

    .saved { color: var(--ink-faint); font-size: 0.92rem; }

    /* ------------------------------------------------------------------
       FOOTER
       ------------------------------------------------------------------ */
    footer {
      margin-top: 2rem; color: var(--ink-faint); font-size: 0.9rem;
      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;
    }

    /* ------------------------------------------------------------------
       SUBMIT CARD - the last thing on every lab
       A wide rounded rectangle, outlined in the accent color, with a solid
       accent block on the left (120px) holding an "open in another page"
       icon, and the call to action centered in the rest. The whole card is
       one link. The build writes the href from the lab's submit: line; the
       instructor pastes the LMS link there. Two blank lines above it, as asked.
       ------------------------------------------------------------------ */
    .submit-card {
      display: flex; align-items: stretch;
      margin-top: 3.4rem;                       /* about two blank lines */
      min-height: 84px;
      border: 2px solid var(--accent); border-radius: 14px; overflow: hidden;
      background: var(--card); color: var(--ink);
      text-decoration: none; font-weight: 700; font-size: 1.15rem;
    }
    .submit-card .submit-icon {
      flex: 0 0 120px; display: flex; align-items: center; justify-content: center;
      background: var(--accent); color: #fff;
    }
    .submit-card .submit-icon svg { width: 40px; height: 40px; }
    .submit-card .submit-text {
      flex: 1; display: flex; align-items: center; justify-content: center;
      text-align: center; padding: 1rem 1.25rem;
    }
    .submit-card:hover .submit-text, .submit-card:focus-visible .submit-text { text-decoration: underline; }
    .submit-card:focus-visible { outline: 3px solid var(--accent-text); outline-offset: 3px; }

    /* ------------------------------------------------------------------
       VOCABULARY - clickable terms and their pop-up
       The build inlines the definitions; shared/vocab.js wraps the first
       mention of each term in a step in a .term-link and opens the <dialog>.
       A term link looks like a word with a dotted accent underline, not a
       button, so it reads as "you can ask about this word".
       ------------------------------------------------------------------ */
    .term-link {
      all: unset;                                  /* drop the browser's button look */
      font: inherit; color: inherit; cursor: help;
      text-decoration: underline dotted var(--accent) 2px; text-underline-offset: 3px;
      border-radius: 3px;
    }
    .term-link:hover { background: var(--accent-soft); }
    .term-link:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
    code .term-link { text-underline-offset: 2px; }

    dialog.vocab {
      border: 2px solid var(--accent); border-radius: 14px; padding: 0;
      width: min(92vw, 30rem); max-height: 80vh; overflow: auto;
      background: var(--card); color: var(--ink);
      box-shadow: 0 12px 40px rgba(0,0,0,0.25);
    }
    dialog.vocab::backdrop { background: rgba(26, 21, 35, 0.45); }
    dialog.vocab .vocab-inner { padding: 1.1rem 1.25rem 1rem; }
    dialog.vocab h3 { margin: 0 0 0.6rem; font-family: var(--font-display); color: var(--heading); font-size: 1.25rem; }
    dialog.vocab p { margin: 0 0 0.6rem; line-height: 1.5; }
    dialog.vocab pre.sample {
      background: var(--accent-soft); border-left: 4px solid var(--accent);
      padding: 0.6rem 0.8rem; border-radius: 8px; overflow-x: auto; margin: 0.5rem 0 0.7rem; font-size: 0.9rem;
    }
    dialog.vocab .vocab-foot {
      display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;
      margin: 0.8rem 0 0; padding-top: 0.7rem; border-top: 1px solid var(--line); font-size: 0.9rem;
    }
    dialog.vocab .vocab-foot a { color: var(--accent-text); font-weight: 700; }

    /* Visually hidden, still read aloud. */
    .sr-only {
      position: absolute; width: 1px; height: 1px; overflow: hidden;
      clip: rect(0 0 0 0); white-space: nowrap;
    }

    /* ------------------------------------------------------------------
       THE PRINTED REPORT
       #report-print is filled in by the script when the student clicks
       "Preview and save as PDF". On screen it is hidden. When printing,
       the rest of the page is hidden and only the report shows. The
       browser's print dialog has "Save as PDF" - that is the PDF generator.
       Links stay clickable in the PDF.
       ------------------------------------------------------------------ */
    #report-print { display: none; }

    @media print {
      @page { margin: 2cm; }

      body { background: #fff; color: #000; font-size: 11pt; }
      body.print-report .wrap { display: none; }
      body.print-report #report-print { display: block; }

      #report-print h1 { color: #9900ff; font-size: 20pt; margin-bottom: 0.2rem; }
      #report-print h2 { color: #9900ff; font-size: 13pt; margin: 1.2rem 0 0.3rem; }
      #report-print .meta { color: #444; margin: 0 0 1rem; }
      #report-print .meta a { color: #7a00cc; }
      #report-print .qa { break-inside: avoid; margin-bottom: 0.9rem; }
      #report-print .qa .question { font-weight: 700; margin: 0 0 0.2rem; }
      #report-print .qa .response { white-space: pre-wrap; margin: 0; padding: 0.4rem 0.6rem; border-left: 3px solid #9900ff; }
      #report-print .steps { margin: 0; padding-left: 1.2rem; }
      #report-print .footer { margin-top: 1.5rem; color: #666; font-size: 9pt; border-top: 1px solid #ccc; padding-top: 0.5rem; }
    }

    /* ------------------------------------------------------------------
       WATCH PANEL - an optional video tutorial for the lab
       A <details> that sits between the progress bar and step 1. Not a
       step: it has no Mark done and does not count toward progress. Open
       by default when present. The generator emits it commented out unless
       the lab's source has a video: line.
       ------------------------------------------------------------------ */
    .watch {
      background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
      margin-bottom: var(--gap); overflow: hidden;
    }
    .watch summary {
      cursor: pointer; list-style: none;
      display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
      padding: 0.9rem 1rem;
      font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; color: var(--heading);
    }
    .watch summary::-webkit-details-marker { display: none; }
